# Build mutant-kraken from the local fork ----
# The fork (branch stars-operators) adds LiteralOffByOneOperator and LiteralScaleOperator
# (docs/v2-scenarios-and-mutants-plan.md, section 7). Pass its checkout as a named build context:
#
#   docker build --build-context mutant-kraken=../mutant-kraken -t mutation-base-image -f Dockerfile_Mutation .
#
# Once the fork is pushed, the COPY and install below can be replaced by
#   RUN cargo install --locked --git <fork url> --rev <commit> mutant-kraken
FROM rust:1-bookworm AS builder

ENV CARGO_HOME=/usr/local/cargo \
    RUSTUP_HOME=/usr/local/rustup \
    PATH=/usr/local/cargo/bin:/usr/local/rustup/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Install mutant-kraken into /usr/local/cargo/bin
COPY --from=mutant-kraken . /mutant-kraken
RUN cargo install --locked --path /mutant-kraken/mutant-kraken

FROM debian:bookworm-slim AS runtime

# Minimal runtime deps.
# jq is used by create_mutants.sh to read mutations.json, which names the operator and the file of
# every generated mutant.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates jq \
 && rm -rf /var/lib/apt/lists/*

# Copy the installed binary from the builder stage
COPY --from=builder /usr/local/cargo/bin/mutant-kraken /usr/local/bin/mutant-kraken

# Test mutant-kraken
RUN mutant-kraken --version

# Copy repository into the container
WORKDIR /repo
COPY . /repo

CMD ["bash"]
